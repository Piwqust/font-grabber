FOUNT_DOMAIN=fount.angleford.co
FOUNT_VERSION=2026-09-15-1
FOUNT_PASSWORD_HASH_FILE=/etc/fount/password.hash
# On the shared server with the system Caddy, plain `docker compose` must use the
# existing-Caddy file; otherwise it reads compose.yaml and breaks sign-in.
# COMPOSE_FILE=compose.existing-caddy.yaml
