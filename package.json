{
  "name": "font-grabber",
  "version": "1.1.0",
  "description": "CLI tool to grab fonts from websites and convert them to TTF/OTF",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "font-grabber": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "bun run src/index.tsx",
    "dev": "bun --watch run src/index.tsx"
  },
  "keywords": [
    "font",
    "grabber",
    "converter",
    "ttf",
    "otf",
    "woff",
    "woff2",
    "variable-font"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "@opentui/core": "^0.1.90",
    "@opentui/react": "^0.1.90",
    "@types/opentype.js": "^1.3.9",
    "@types/react": "^19.2.14",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "opentype.js": "^1.3.4",
    "ora": "^9.3.0",
    "puppeteer": "^24.39.1",
    "react": "^19.2.4",
    "wawoff2": "^2.0.1"
  },
  "devDependencies": {
    "@types/commander": "^2.12.0",
    "@types/node": "^25.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
