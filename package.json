{
  "name": "font-grabber",
  "version": "1.1.0",
  "description": "CLI tool to grab fonts from websites and convert them to TTF/OTF",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "font-grabber": "dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.tsx --outdir=dist --target=node",
    "start": "bun src/index.tsx",
    "dev": "bun --watch src/index.tsx"
  },
  "keywords": [
    "font",
    "grabber",
    "converter",
    "ttf",
    "otf",
    "woff",
    "woff2",
    "variable-font"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@opentui/core": "^0.1.90",
    "@opentui/react": "^0.1.90",
    "@types/opentype.js": "^1.3.9",
    "commander": "^14.0.3",
    "opentype.js": "^1.3.4",
    "puppeteer": "^24.39.1",
    "react": "^19.2.4",
    "react-reconciler": "^0.33.0",
    "wawoff2": "^2.0.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/commander": "^2.12.0",
    "@types/node": "^25.5.0",
    "esbuild": "^0.27.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
